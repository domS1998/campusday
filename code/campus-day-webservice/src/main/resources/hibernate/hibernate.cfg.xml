<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Connection settings -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5000/campus_day_app</property>
<!--        <property name="hibernate.connection.url">jdbc:postgresql://datenbank:5432/se_bachelor_projekt_messenger_app</property>-->
        <property name="hibernate.connection.username">campus_day_app</property>
        <property name="hibernate.connection.password">campus_day_app</property>
        <property name="hibernate.current_session_context_class">thread</property>
        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Print executed SQL to stdout -->
        <!-- <property name="show_sql">true</property> -->

        <!-- Update database on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Annotated entity classes -->
        <mapping class="org.server.orm.classes.UserDAO"/>
        <mapping class="org.server.orm.classes.StationDAO"/>
        <mapping class="org.server.orm.classes.UserStationDao"/>

    </session-factory>
</hibernate-configuration>
